# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
scripts/benchmark-reports/.c009-regression-state.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
google-cloud-key.json
*-gcp-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
remote_schema.sql

# benchmark reports
scripts/benchmark-reports/

# supabase cli local state
supabase/.temp/

# Agent / AI tooling — local only, never committed
AGENTS.md
opencode.json
opencode.jsonc
.opencode/
.claude/
CLAUDE.md
.ignore

# Local audit reports (regenerable, not committed)
AUDIT_REPORT.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
